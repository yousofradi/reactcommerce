generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String       @id @default(uuid())
  name            String
  handle          String       @unique @default("")
  basePrice       Float
  salePrice       Float?
  imageUrl        String?      @default("")
  images          String[]     @default([])
  description     String?      @default("")
  
  primaryCollectionId String?
  primaryCollection   Collection? @relation("PrimaryCollection", fields: [primaryCollectionId], references: [id])
  collections         Collection[] @relation("ProductCollections")
  
  options         Json         @default("[]") // OptionGroups
  variants        Json         @default("[]") // Variants
  
  sortOrder       Int          @default(0)
  active          Boolean      @default(true)
  status          String       @default("active") // "active" | "draft"
  quantity        Int?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([active, status])
  @@index([handle])
}

model Collection {
  id              String       @id @default(uuid())
  name            String
  urlName         String?      @unique
  description     String?      @default("")
  imageUrl        String?      @default("")
  sortOrder       Int          @default(0)
  
  primaryProducts Product[]    @relation("PrimaryCollection")
  products        Product[]    @relation("ProductCollections")

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Order {
  id                  String       @id @default(uuid())
  orderId             String       @unique // e.g. "Order-1001"
  
  // Customer details embedded as JSON or separate fields
  customerName        String
  customerPhone       String
  customerSecondPhone String?      @default("")
  customerAddress     String
  customerGov         String
  customerZone        String?
  customerNotes       String?      @default("")

  items               Json         @default("[]") // OrderItem details

  discount            Float        @default(0)
  totalPrice          Float
  shippingFee         Float
  paymentMethod       String
  paid                Boolean      @default(false)
  paidAmount          Float        @default(0)
  archived            Boolean      @default(false)
  status              String       @default("pending") // pending, cancelled, ready
  
  bostaDeliveryId     String?
  bostaTrackingNumber String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Shipping {
  id            String   @id @default(uuid())
  city          String   @unique
  cityOtherName String?
  bostaCityId   String?
  fee           Float    @default(0)
  zones         Json     @default("[]") // Array of { name, otherName, bostaZoneId }

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Counter {
  id          String   @id
  seq         Int      @default(0)
}

model Webhook {
  id          String   @id @default(uuid())
  url         String
  events      String[]
  secret      String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PushSubscription {
  id          String   @id @default(uuid())
  endpoint    String   @unique
  keys        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
